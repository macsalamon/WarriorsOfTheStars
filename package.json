{
  "name": "warriors-of-the-stars",
  "version": "0.2.0",
  "private": true,
  "description": "Warriors of the Stars: a free fan-made digital edition of a starfighter combat board game, for the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "host": "vite build && vite-node server/main.ts",
    "host:internet": "vite build && vite-node server/main.ts --internet",
    "serve": "vite-node server/main.ts",
    "release": "node scripts/build-release.mjs",
    "sounds": "node tools/sound-pack.mjs",
    "models": "node tools/model-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.21.5",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "ws": "^8.22.1"
  }
}
