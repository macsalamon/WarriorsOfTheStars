      "E": { "top": ["SPD?","LOSE","T+1","LOSE","-","SPD?","SPD?","A+3","LOSE","LOSE"], "bottom": ["L","Stb","-","Stb","LOSE","LOSE","E","E","L","Roll"] },
      "F": { "top": ["LOSE","-","T+1","SPD?","-","LOSE","A+3","LOSE","LOSE","-"], "bottom": ["G","T+1","A+3","A+3","Roll","A+3","-","LOSE","Roll","-"] },
      "G": { "top": ["-","LOSE","-","T+1","-","A+3","SPD?","-","Roll","-"], "bottom": ["-","A+3","Roll","Roll","-","-","A+3","T+1","-","SPD2?"] }
    }
  },
  "fire": {
    "_note": "Modified roll = 2d6 + power. <=2 is no effect (ion cannons still look up, floor of -1). >=14 destroys. Each entry is the list of damage codes for the column in 'columns'. portStarboard is used only with the advanced arcs.",
