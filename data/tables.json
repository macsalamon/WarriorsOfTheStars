  "hazard": {
    "_note": "Roll 2d6; a 7 is always no effect. Columns: 2,3,4,5,6,8,9,10,11,12. Each row has a top and bottom code per column; a minor hazard uses only the top. Row A is used only with the damage rules.",
    "columns": [2,3,4,5,6,8,9,10,11,12],
    "rows": {
      "A": { "top": ["A+3","A+3","SPD?","LOSE","LOSE","LOSE","LOSE","LOSE","A+3","SPD?"], "bottom": ["A+3","LOSE","LOSE","SPD2?","LOSE","LOSE","Stb","Stb","SPD2?","A+6"] },
      "B": { "top": ["A+6","A+3","SPD?","A+3","T+1","Roll","Roll","T+1","A+3","SPD?"], "bottom": ["Stb","A+3","T+2","T+2","T+1","Roll","A+3","L","Stb","A+6"] },
      "C": { "top": ["Roll","T+1","SPD?","LOSE","A+3","A+3","Roll","LOSE","SPD?","-"], "bottom": ["E","Stb","L","T+2","LOSE","LOSE","LOSE","LOSE","L","Stb"] },
